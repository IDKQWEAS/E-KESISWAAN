APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:te4UEPKKVcqFT3oFJnXaNliOoeLMZgkyjfXowiOfS1g=
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- KONFIGURASI DATABASE LOKAL (LARAGON) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=e_kesiswaan
DB_USERNAME=root
DB_PASSWORD=

# --- KONFIGURASI SESSION ---
# Tetap gunakan 'file' agar tidak error jika tabel session belum ada di database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# --- KUNCI UTAMA: HUBUNGKAN KE BACKEND NODE.JS ---
# Ganti dari Railway ke Localhost port 3000 (sesuai terminal node index.js tadi)
API_BASE_URL="http://127.0.0.1:3000/api"
VITE_API_BASE_URL="http://127.0.0.1:3000/api"

# --- KONFIGURASI LAINNYA ---
LOG_CHANNEL=stack
LOG_LEVEL=debug
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file